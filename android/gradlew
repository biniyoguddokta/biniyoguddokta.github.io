#!/usr/bin/env sh
# Self-contained Gradle launcher: downloads the pinned Gradle distribution when needed.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
GRADLE_VERSION=8.7
GRADLE_USER_HOME=${GRADLE_USER_HOME:-$HOME/.gradle}
GRADLE_HOME="$GRADLE_USER_HOME/wrapper/manual/gradle-$GRADLE_VERSION"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$GRADLE_USER_HOME/wrapper/manual"
  ZIP="$GRADLE_USER_HOME/wrapper/manual/gradle-$GRADLE_VERSION-bin.zip"
  if [ ! -f "$ZIP" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP"
    else
      echo 'curl is required to download Gradle.' >&2; exit 1
    fi
  fi
  unzip -q -o "$ZIP" -d "$GRADLE_USER_HOME/wrapper/manual"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
